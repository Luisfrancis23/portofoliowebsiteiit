# Kopia ficheiru ne'e ba .env.local e haree/troka valor sira.
# La tau segredo real iha GitHub!

# URL publika website (ex.: https://seu-naran.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email destinu ba mensajen formuláriu kontaktu
CONTACT_TO_EMAIL=kontaktu@exemplo.com

# Resend API key (https://resend.com) — opsional.
# Se la iha, formuláriu still simu mensajen maibé la haruka email (hatudu avisu "seidauk konfiguradu").
RESEND_API_KEY=

# Remetente (deve ser dominio Resend ne'ebé verificada)
RESEND_FROM=Portfolio <kontaktu@exemplo.com>
